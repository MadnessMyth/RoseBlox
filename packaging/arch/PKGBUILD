# Maintainer: Roseblox contributors
pkgname=roseblox
pkgver=0.2.2
pkgrel=1
pkgdesc='Native GTK launcher and installation manager for Roblox through Rosemary'
arch=('any')
url='https://github.com/MadnessMyth/RoseBlox'
license=('MIT')
depends=('gtk4' 'libadwaita' 'python' 'python-gobject' 'xdg-utils')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('libarchive: required for importing or extracting Roblox ZIP archives (bsdtar)')

source=(
  "roseblox-${pkgver}.tar.gz::https://github.com/MadnessMyth/RoseBlox/archive/refs/tags/v${pkgver}.tar.gz"
  'io.github.roseblox.Roseblox.desktop'
  'io.github.roseblox.Roseblox.svg'
)
sha256sums=(
  '9b0b4ef68d4bf3df3aab0dffc40fcc22c1d73bc1ce7c7aeea509e463cfd49626'
  'cd9e1e127ca6ccb21056d185527be2ca2bbf45ebe44540020ca8438ea579045d'
  'd95259e28df1478d01c8555180e83dc2d8064b8fc95110a03104152d3278a863'
)

build() {
  cd "$srcdir/RoseBlox-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/RoseBlox-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "$srcdir/io.github.roseblox.Roseblox.desktop" \
    "$pkgdir/usr/share/applications/io.github.roseblox.Roseblox.desktop"
  install -Dm644 "$srcdir/io.github.roseblox.Roseblox.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.roseblox.Roseblox.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
